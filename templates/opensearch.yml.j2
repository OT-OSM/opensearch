cluster.name: {{ opensearch_cluster_name }}
node.name: {{ opensearch_node_name }}

network.host: {{ opensearch_network_host }}
{% if opensearch_network_publish_host is defined %}
network.publish_host: {{ opensearch_network_publish_host }}
{% endif %}

http.port: {{ opensearch_http_port }}
transport.port: {{ opensearch_transport_port }}

node.roles: {{ opensearch_node_roles }}

# -------------------------------------------------
# Discovery
# -------------------------------------------------
discovery.seed_hosts:
{% if opensearch_discovery_seed_hosts is defined and opensearch_discovery_seed_hosts | length > 0 %}
{% for host in opensearch_discovery_seed_hosts %}
  - {{ host }}
{% endfor %}
{% else %}
{% for h in ansible_play_hosts_all %}
  - {{ hostvars[h].ansible_host | default(h) }}
{% endfor %}
{% endif %}

# -------------------------------------------------
# Initial cluster manager nodes
# -------------------------------------------------
{% if opensearch_cluster_initial_master_nodes is defined and
      opensearch_cluster_initial_master_nodes | length > 0 %}
cluster.initial_cluster_manager_nodes:
{% for node in opensearch_cluster_initial_master_nodes %}
  - {{ node }}
{% endfor %}
{% endif %}

path.data: {{ opensearch_data_dir }}
path.logs: {{ opensearch_log_dir }}

bootstrap.memory_lock: true

# -------------------------------------------------
# Security plugin switch
# -------------------------------------------------
{% if not opensearch_security_enabled | bool %}
plugins.security.disabled: true
{% endif %}

########################################
# SECURITY – only when enabled
########################################
{% if opensearch_security_enabled | bool %}

plugins.security.allow_unsafe_democertificates: {{ opensearch_security_allow_unsafe_democertificates | default(false) | lower }}
plugins.security.allow_default_init_securityindex: {{ opensearch_security_allow_default_init_securityindex | default(false) | lower }}

########################################
# HTTP TLS
########################################
{% if opensearch_http_ssl_enabled | bool %}
plugins.security.ssl.http.enabled: true
plugins.security.ssl.http.pemcert_filepath: {{ opensearch_ssl_cert_filename }}
plugins.security.ssl.http.pemkey_filepath: {{ opensearch_ssl_key_filename }}
plugins.security.ssl.http.pemtrustedcas_filepath: {{ opensearch_ssl_ca_filename }}
{% endif %}

########################################
# TRANSPORT TLS (node-to-node)
########################################
{% if opensearch_transport_ssl_enabled | bool %}
plugins.security.ssl.transport.enabled: true
plugins.security.ssl.transport.pemcert_filepath: {{ opensearch_ssl_cert_filename }}
plugins.security.ssl.transport.pemkey_filepath: {{ opensearch_ssl_key_filename }}
plugins.security.ssl.transport.pemtrustedcas_filepath: {{ opensearch_ssl_ca_filename }}
plugins.security.ssl.transport.enforce_hostname_verification: false
{% endif %}

{% if opensearch_security_allow_unsafe_democertificates | bool %}
plugins.security.authcz.admin_dn:
{% for dn in opensearch_admin_dn_list %}
  - "{{ dn }}"
{% endfor %}
{% endif %}

{% endif %}

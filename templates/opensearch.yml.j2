# ===========================
# OpenSearch Configuration
# Managed by Ansible
# ===========================

{% set is_cluster = (opensearch_enable_cluster_mode | bool) and ((opensearch_discovery_seed_hosts | length > 0) or (opensearch_initial_master_nodes | length > 0) or (groups['opensearch'] | default([]) | length > 1)) %}

# ===========================
# Cluster / Node
# ===========================
{% if is_cluster %}
cluster.name: {{ opensearch_cluster_name }}
{% else %}
cluster.name: {{ opensearch_cluster_name }}-standalone
{% endif %}
node.name: {{ opensearch_node_name }}

path.data: {{ opensearch_data_path }}
path.logs: {{ opensearch_logs_path }}

# ===========================
# Network & Connectivity
# ===========================
network.host: {{ opensearch_network_host }}
http.port: {{ opensearch_http_port }}
transport.port: {{ opensearch_transport_port }}

# ===========================
# Discovery
# ===========================
{% if is_cluster %}
discovery.seed_hosts:
{% if opensearch_discovery_seed_hosts | length > 0 %}
{% for host in opensearch_discovery_seed_hosts %}
  - {{ hostvars[host]['private_ip'] | default(hostvars[host]['ansible_host']) | default(host) }}
{% endfor %}
{% else %}
{% for host in groups['opensearch'] %}
  - {{ hostvars[host]['private_ip'] | default(hostvars[host]['ansible_default_ipv4']['address']) | default(hostvars[host]['ansible_host']) | default(host) }}
{% endfor %}
{% endif %}

{% if opensearch_bootstrap_cluster | bool or (opensearch_initial_master_nodes | length > 0) %}
cluster.initial_master_nodes:
{% if opensearch_initial_master_nodes | length > 0 %}
{% for node in opensearch_initial_master_nodes %}
  - {{ node }}
{% endfor %}
{% else %}
{% for host in groups['opensearch'] %}
  - {{ host }}
{% endfor %}
{% endif %}
{% endif %}
{% else %}
discovery.type: single-node
{% endif %}

# ===========================
# Node Roles
# ===========================
node.roles:
{% for role in opensearch_node_roles %}
  - {{ role }}
{% endfor %}

# ===========================
# Memory / Bootstrap
# ===========================
bootstrap.memory_lock: {{ opensearch_bootstrap_memory_lock | default(false) }}

# ===========================
# Performance
# ===========================
cluster.routing.allocation.disk.threshold_enabled: true
cluster.info.update.interval: 30s

# ===========================
# Security (TLS / Auth)
# ===========================
{% if opensearch_use_tls | bool %}

plugins.security.enabled: true

# Transport layer (node-to-node)
plugins.security.ssl.transport.pemcert_filepath: {{ opensearch_transport_node_cert_path }}
plugins.security.ssl.transport.pemkey_filepath: {{ opensearch_transport_node_key_path }}
plugins.security.ssl.transport.pemtrustedcas_filepath: {{ opensearch_transport_root_ca_path }}
plugins.security.ssl.transport.enforce_hostname_verification: false

# HTTP layer (client-to-node)
plugins.security.ssl.http.enabled: true
plugins.security.ssl.http.pemcert_filepath: {{ opensearch_node_cert_path }}
plugins.security.ssl.http.pemkey_filepath: {{ opensearch_node_key_path }}
plugins.security.ssl.http.pemtrustedcas_filepath: {{ opensearch_root_ca_path }}

# Admin DNs
plugins.security.authcz.admin_dn:
  - "CN=opensearch-admin"
{% if opensearch_admin_dn | length > 0 %}
{% for dn in opensearch_admin_dn %}
  - {{ dn }}
{% endfor %}
{% endif %}

# Node DNs
plugins.security.nodes_dn:
  - "CN=opensearch-node"
{% if opensearch_nodes_dn | length > 0 %}
{% for dn in opensearch_nodes_dn %}
  - {{ dn }}
{% endfor %}
{% endif %}

# Security behaviour
plugins.security.allow_unsafe_democertificates: true
plugins.security.allow_default_init_securityindex: true
plugins.security.enable_snapshot_restore_privilege: true
plugins.security.check_snapshot_restore_write_privileges: true

plugins.security.restapi.roles_enabled:
  - all_access
  - security_rest_api_access

plugins.security.audit.type: internal_opensearch

plugins.security.system_indices.enabled: true
plugins.security.system_indices.indices:
  - ".opendistro-alerting-config"
  - ".opendistro-alerting-alert*"
  - ".opendistro-anomaly-results*"
  - ".opendistro-anomaly-detector*"
  - ".opendistro-anomaly-checkpoints"
  - ".opendistro-anomaly-detection-state"
  - ".opendistro-reports-*"
  - ".opendistro-notifications-*"
  - ".opendistro-notebooks"
  - ".opendistro-asynchronous-search-response*"

{% else %}

plugins.security.disabled: true

{% endif %}

# ===========================
# SSO Configuration
# ===========================
{% if opensearch_enable_sso | bool and opensearch_use_tls | bool %}

{% if opensearch_auth_type == 'openid' %}
# OpenID Connect
plugins.security.auth.type: "openid"
plugins.security.openid.connect_url: "{{ opensearch_openid_connect_url }}"
plugins.security.openid.client_id: "{{ opensearch_openid_client_id }}"
plugins.security.openid.client_secret: "{{ opensearch_openid_client_secret }}"
plugins.security.openid.scope: "{{ opensearch_openid_scope }}"
{% if opensearch_openid_base_redirect_url %}
plugins.security.openid.base_redirect_url: "{{ opensearch_openid_base_redirect_url }}"
{% endif %}
{% endif %}

{% if opensearch_auth_type == 'saml' %}
# SAML
plugins.security.auth.type: "saml"
plugins.security.saml.idp.metadata_url: "{{ opensearch_saml_idp_metadata_url }}"
plugins.security.saml.sp.entity_id: "{{ opensearch_saml_entity_id }}"
plugins.security.saml.exchange_key: "{{ opensearch_saml_exchange_key }}"
{% endif %}

{% endif %}

# ===========================
# Metrics / Monitoring
# ===========================
{% if opensearch_metrics_enabled | bool %}
opensearch.experimental.feature.telemetry.enabled: true
{% endif %}

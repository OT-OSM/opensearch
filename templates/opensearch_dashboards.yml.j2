# OpenSearch Dashboards Configuration

server.port: {{ opensearch_dashboards_port }}
server.host: "{{ opensearch_dashboards_host }}"

{% if opensearch_enable_sso | bool and opensearch_auth_type == 'openid' %}
server.publicBaseUrl: "{{ opensearch_openid_base_redirect_url | regex_replace('/$', '') }}"
{% endif %}

# OpenSearch Connection

{% if opensearch_use_tls | bool %}
opensearch.hosts:
  - "https://localhost:{{ opensearch_http_port }}"

opensearch.ssl.verificationMode: none
opensearch.ssl.certificateAuthorities:
  - {{ opensearch_dashboards_config_dir }}/certs/root-ca.pem

{% else %}
opensearch.hosts:
  - "http://localhost:{{ opensearch_http_port }}"
{% endif %}

# Backend Service Auth

opensearch.username: "{{ opensearch_kibanaserver_username }}"
opensearch.password: "{{ opensearch_kibanaserver_password }}"

# UI Security

opensearch_security.enabled: true

{% if opensearch_enable_sso | bool and opensearch_auth_type == 'openid' %}
opensearch_security.auth.type: "openid"
opensearch_security.openid.connect_url: "{{ opensearch_openid_connect_url }}"
opensearch_security.openid.client_id: "{{ opensearch_openid_client_id }}"
opensearch_security.openid.client_secret: "{{ opensearch_openid_client_secret }}"
opensearch_security.openid.scope: "{{ opensearch_openid_scope }}"
opensearch_security.openid.base_redirect_url: "{{ opensearch_openid_base_redirect_url }}"
{% if opensearch_use_tls | bool %}
opensearch_security.openid.root_ca: "{{ opensearch_dashboards_config_dir }}/certs/root-ca.pem"
{% endif %}
{% else %}
opensearch_security.auth.type: "basicauth"
{% endif %}

# TLS (Browser → Dashboards)

{% if opensearch_use_tls | bool %}
server.ssl.enabled: true
server.ssl.certificate: {{ opensearch_dashboards_config_dir }}/certs/node.pem
server.ssl.key: {{ opensearch_dashboards_config_dir }}/certs/node-key.pem
{% else %}
server.ssl.enabled: false
{% endif %}

_meta:
  type: "rolesmapping"
  config_version: 2

all_access:
  reserved: true
  backend_roles:
    - "admin"
  users:
    - "{{ opensearch_admin_username }}"

snapshot_management_full_access:
  reserved: true
  backend_roles:
    - "admin"
  users:
    - "{{ opensearch_admin_username }}"


kibana_server:
  reserved: true
  users:
    - "{{ opensearch_kibanaserver_username }}"

kibana_user:
  reserved: false
  users:
    - "{{ opensearch_admin_username }}"

security_rest_api_access:
  users:
    - "{{ opensearch_admin_username }}"

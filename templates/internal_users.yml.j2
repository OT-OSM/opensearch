_meta:
  type: "internalusers"
  config_version: 2

# Define the admin user
{{ opensearch_admin_username }}:
  hash: "{{ opensearch_admin_password_hash }}"
  reserved: true
  backend_roles:
  - "admin"
  description: "Admin user"

# Keep kibanaserver user for Dashboards internal use
kibanaserver:
  hash: "{{ opensearch_kibanaserver_password_hash }}"
  reserved: true
  description: "Dashboards internal user"

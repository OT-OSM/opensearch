cluster.name: {{ opensearch_cluster_name }}
node.name: {{ opensearch_node_name }}

path.data: /var/lib/opensearch
path.logs: /var/log/opensearch

network.host: {{ opensearch_network_host }}
http.port: {{ opensearch_http_port }}
transport.port: {{ opensearch_transport_port }}

discovery.seed_hosts:
{% for host in opensearch_discovery_seed_hosts %}
  - {{ host }}
{% endfor %}

cluster.initial_master_nodes:
{% for node in opensearch_initial_master_nodes %}
  - {{ node }}
{% endfor %}

node.roles:
{% for role in opensearch_node_roles %}
  - {{ role }}
{% endfor %}

# JVM options are handled in jvm.options, but heap size can be referenced here if needed
# bootstrap.memory_lock: true

{% if opensearch_use_tls %}
plugins.security.disabled: false
plugins.security.ssl.transport.pemcert_filepath: {{ opensearch_certs_dir }}/node.pem
plugins.security.ssl.transport.pemkey_filepath: {{ opensearch_certs_dir }}/node-key.pem
plugins.security.ssl.transport.pemtrustedcas_filepath: {{ opensearch_certs_dir }}/root-ca.pem
plugins.security.ssl.transport.enforce_hostname_verification: false
plugins.security.ssl.http.enabled: true
plugins.security.ssl.http.pemcert_filepath: {{ opensearch_certs_dir }}/node.pem
plugins.security.ssl.http.pemkey_filepath: {{ opensearch_certs_dir }}/node-key.pem
plugins.security.ssl.http.pemtrustedcas_filepath: {{ opensearch_certs_dir }}/root-ca.pem
plugins.security.allow_unsafe_democertificates: false
plugins.security.allow_default_init_securityindex: true

plugins.security.authcz.admin_dn:
{% for dn in opensearch_admin_dn %}
  - {{ dn }}
{% endfor %}

plugins.security.nodes_dn:
{% for dn in opensearch_nodes_dn %}
  - {{ dn }}
{% endfor %}

plugins.security.audit.type: internal_opensearch
plugins.security.enable_snapshot_restore_privilege: true
plugins.security.check_snapshot_restore_write_privileges: true
plugins.security.restapi.roles_enabled: ["all_access", "security_rest_api_access"]
plugins.security.system_indices.enabled: true
plugins.security.system_indices.indices: [".opendistro-alerting-config", ".opendistro-alerting-alert*", ".opendistro-anomaly-results*", ".opendistro-anomaly-detector*", ".opendistro-anomaly-checkpoints", ".opendistro-anomaly-detection-state", ".opendistro-reports-*", ".opendistro-notifications-*", ".opendistro-notebooks", ".opendistro-asynchronous-search-response*"]

{% else %}
plugins.security.disabled: true
{% endif %}

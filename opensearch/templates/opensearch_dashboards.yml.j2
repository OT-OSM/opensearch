# =================== OpenSearch Dashboards Configuration ====================
#
# Managed by Ansible - Do not edit manually
#

# --------------------------------- Server -------------------------------------
server.port: {{ dashboards_port }}
server.host: "{{ dashboards_host }}"
server.name: "{{ dashboards_server_name }}"

# ----------------------------- OpenSearch Connection --------------------------
opensearch.hosts:
{% for host in groups['opensearch'] %}
  - "{{ 'https' if opensearch_security_tls_enabled else 'http' }}://{{ hostvars[host]['ansible_host'] | default(host) }}:{{ opensearch_http_port }}"
{% endfor %}

{% if opensearch_security_enabled %}
# --------------------------------- Security -----------------------------------
opensearch.username: "{{ opensearch_dashboards_username | default('kibanaserver') }}"
opensearch.password: "{{ opensearch_kibanaserver_password }}"

opensearch.requestHeadersWhitelist:
  - authorization
  - securitytenant

{% if opensearch_security_tls_enabled %}
# -------------------------------- TLS/SSL -------------------------------------
opensearch.ssl.verificationMode: none
opensearch.ssl.certificateAuthorities: ["{{ dashboards_config_dir }}/certs/{{ opensearch_root_ca }}"]
{% else %}
# TLS disabled
opensearch.ssl.verificationMode: none
{% endif %}

# Security plugin settings
opensearch_security.multitenancy.enabled: true
opensearch_security.multitenancy.tenants.preferred: ["Private", "Global"]
opensearch_security.readonly_mode.roles: ["kibana_read_only"]

# Cookie security
opensearch_security.cookie.secure: {{ opensearch_security_tls_enabled | lower }}
{% endif %}

# --------------------------------- Logging ------------------------------------
logging.dest: {{ dashboards_log_dir }}/opensearch-dashboards.log
logging.verbose: false

# ----------------------------- Advanced Options -------------------------------
opensearch.requestTimeout: 30000
opensearch.shardTimeout: 30000

{% if not opensearch_security_enabled %}
# When OpenSearch Security is disabled, disable Dashboards security login too
opensearch_security.enabled: false
opensearch.ssl.verificationMode: none
{% endif %}
